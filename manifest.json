{
  "name": "Gig Timer",
  "description": "Gig Timer tracks how long each contract takes.",
  "version": "1.0",
  "manifest_version": 3,
  "options_page": "html/options.html",
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Gig Timer"
  },
  "host_permissions": [
    "https://phelix.pixelogicmedia.com/*",
    "https://authoring.netflixstudios.com/*",
    "https://originatorstudio.netflixstudios.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "webNavigation",
    "downloads",
    "scripting"
  ],
  "background": {
    "service_worker": "./background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://phelix.pixelogicmedia.com/*",
        "https://authoring.netflixstudios.com/*",
        "https://originatorstudio.netflixstudios.com/*"
      ],
      "js": [
        "content/inject-bridge.js",
        "content/stopwatch.js",
        "content/assignments.js",
        "content/workplace.js",
        "content/overlay.js",
        "content/popup.js"
      ],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://phelix.pixelogicmedia.com/*",
        "https://authoring.netflixstudios.com/*",
        "https://originatorstudio.netflixstudios.com/*"
      ],
      "resources": [
        "web-accessible-resources/bridge.js",
        "web-accessible-resources/normalization.js",
        "utils/netflix.js",
        "utils/workplace.js",
        "utils/pixelogic.js"
      ]
    }
  ]
}
